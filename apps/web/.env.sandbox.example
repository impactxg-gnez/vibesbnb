# Copy into apps/web/.env.local when developing against the sandbox database.
# Never point these at production Supabase or live Stripe/PayPal keys.

# Required — marks this checkout as sandbox (banner + noindex).
NEXT_PUBLIC_APP_ENV=sandbox

# Public origin of the hosted Preview (or http://localhost:3000 locally).
NEXT_PUBLIC_APP_URL=https://YOUR-SANDBOX-ALIAS.vercel.app

# Dedicated vibesbnb-sandbox Supabase project (not production).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-SANDBOX-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_or_anon_key
SUPABASE_SERVICE_ROLE_KEY=service_role_key

# Payments — test mode only.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_PAYPAL_CLIENT_ID=sandbox_paypal_client_id
PAYPAL_CLIENT_SECRET=sandbox_paypal_secret

# Optional; allow the sandbox origin on the Maps key if you reuse prod.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_API_KEY=

# Email — use a test/dev Resend key or leave unset.
RESEND_API_KEY=
RESEND_FROM_EMAIL=VibesBNB Sandbox <noreply@vibesbnb.com>

# Do not set production calendar cron secrets on Preview.
# CALENDAR_CRON_SECRET=
